{
  "_comment": "Arm definitions. Every arm shares the verification-only Bash policy (bench/policy), WebFetch/WebSearch disallowed, identical caps per size class, identical task prompt. conductor_alias resolves through ANTHROPIC_DEFAULT_<ALIAS>_MODEL in the generated settings; the resolved id is recorded from the transcript.",
  "arms": {
    "solo-opus":     {"conductor_alias": "opus",   "plugin": false, "appendix": null,                          "disallowed_tools": ["WebFetch", "WebSearch"]},
    "solo-sonnet":   {"conductor_alias": "sonnet", "plugin": false, "appendix": null,                          "disallowed_tools": ["WebFetch", "WebSearch"]},
    "hybrid-inst":   {"conductor_alias": "opus",   "plugin": true,  "appendix": "hybrid-appendix.md",         "disallowed_tools": ["WebFetch", "WebSearch"]},
    "hybrid-forced": {"conductor_alias": "opus",   "plugin": true,  "appendix": "hybrid-forced-appendix.md",  "disallowed_tools": ["WebFetch", "WebSearch", "Edit", "Write", "MultiEdit", "NotebookEdit"]},
    "hybrid-natural":{"conductor_alias": "opus",   "plugin": true,  "appendix": null,                          "disallowed_tools": ["WebFetch", "WebSearch"]}
  },
  "effort": "high",
  "caps": {
    "small":  {"max_budget_usd": 8,  "max_turns": 80,  "wall_s": 1500},
    "medium": {"max_budget_usd": 15, "max_turns": 120, "wall_s": 2400},
    "large":  {"max_budget_usd": 40, "max_turns": 200, "wall_s": 4500}
  },
  "agy_timeout": "10m",
  "cold_gap_s": 300
}
